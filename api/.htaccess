# Block direct access to sensitive files
<FilesMatch "\.(json|sql|log|token|md|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to config and setup files
<FilesMatch "^(config|setup|test-|admin-setup|admin-update).*\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Disable directory listing
Options -Indexes
